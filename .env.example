# Server
NODE_ENV=development
PORT=4000
# Multiple origins can be comma-separated for local network/mobile testing.
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
DB_PATH=./data/nova.sqlite

# Optional OpenAI-compatible provider. Leave blank until ready.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=60000

# Frontend (Vite)
VITE_API_URL=
