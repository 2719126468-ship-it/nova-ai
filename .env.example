# Server
NODE_ENV=development
PORT=4000
# Multiple origins can be comma-separated for local network/mobile testing.
WEB_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-at-least-32-random-characters
DB_PATH=./data/nova.sqlite

# Optional OpenAI-compatible provider. Leave blank until ready.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional JSON array for multiple OpenAI-compatible providers; keys stay server-side.
AI_PROVIDERS_JSON=
# Optional public model id, e.g. deepseek:deepseek-chat (defaults to first selectable model).
AI_DEFAULT_MODEL=
# Required only for admin-managed Providers; generate once with `openssl rand -hex 32` and keep stable.
PROVIDER_ENCRYPTION_KEY=
AI_TIMEOUT_MS=60000

# Optional real web search for NOVA Research. Choose SearXNG (no API key) or Brave.
# SearXNG: base URL of an instance with the JSON output format enabled.
RESEARCH_SEARCH_PROVIDER=searxng
RESEARCH_SEARCH_URL=
# Alternative: Brave Search API (store the key only on the server).
BRAVE_SEARCH_API_KEY=
RESEARCH_SEARCH_TIMEOUT_MS=12000
# Approximate message-content budget in characters, not model tokens.
AI_MAX_CONTEXT_CHARS=40000
AI_CONTEXT_OUTPUT_RESERVE=2048
AI_CONTEXT_SAFETY_MARGIN_PERCENT=10

# Frontend (Vite)
VITE_API_URL=
