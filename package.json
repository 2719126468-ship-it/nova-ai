{
  "name": "nova-ai-platform",
  "version": "0.1.0",
  "private": true,
  "description": "A full-stack AI product platform starter with an extensible provider adapter.",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "test": "npm run test -w server",
    "start": "npm run start -w server",
    "e2e": "node scripts/e2e-smoke.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "admin:promote": "npm run admin:promote -w server",
    "db:backup": "npm run db:backup -w server",
    "db:restore": "npm run db:restore -w server",
    "db:verify": "npm run db:verify -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "puppeteer-core": "^25.16.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true
  }
}
